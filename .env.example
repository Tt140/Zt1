# ==============================================================================
# Autonomous Zero-Trust SecOps Agent — Environment Configuration Template
# ==============================================================================
# 📋 INSTRUCTIONS:
# 1. Copy this template to create your local .env file:
#       cp .env.example .env
# 2. Replace all placeholder values below with your real AWS, LLM, and Slack credentials.
# 3. NEVER commit your actual .env file to Git! (.gitignore is pre-configured to ignore it).
# ==============================================================================

# ── 1. AWS Configuration ──────────────────────────────────────────────────────
# The AWS region where your DynamoDB tables, S3 blobs, and target EC2 hosts reside.
AWS_REGION=us-east-1

# Optional: Target EC2 instance ID for local testing. If omitted, the agent
# dynamically discovers the running instance tagged IncidentsAgent=true.
# TARGET_INSTANCE_ID=i-0123456789abcdef0

# ── 2. DynamoDB EventStore Tables ─────────────────────────────────────────────
# Core append-only event sourcing ledger tables provisioned by template.yaml.
EVENTS_TABLE=incidents-events
DEDUP_TABLE=incidents-dedup
LEASES_TABLE=incidents-leases

# ── 3. Amazon S3 Storage ──────────────────────────────────────────────────────
# S3 bucket for offloading large observation outputs (> 300 KB).
# Format: incidents-blobs-<YOUR_AWS_ACCOUNT_ID>
BLOBS_BUCKET=incidents-blobs-YOUR_ACCOUNT_ID_HERE

# ── 4. Strands Decider 2B ─────────────────────────────────────────────────────
# URL of hosted Strands Decider 2B service, or 'embedded' for the sub-millisecond in-memory engine.
STRANDS_URL=embedded

# ── 5. Foundation Model Inference (Amazon Bedrock / DeepSeek) ─────────────────
# OpenAI-compatible API endpoint for generative argument synthesis.
DEEPSEEK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
DEEPSEEK_FLASH_MODEL=deepseek.v3.2
DEEPSEEK_PRO_MODEL=deepseek.v3.2
INCIDENTS_FLASH_MODEL=bedrock:deepseek.v3.2

# Your Bedrock Mantle / DeepSeek Bearer Token or API Key.
# Required for live reasoning cycles.
DEEPSEEK_API_KEY=your_deepseek_api_key_or_bedrock_bearer_token_here

# ── 6. Slack Notifications & Interactive Governance (Tier T2) ──────────────────
# Incoming webhook URL for incident notifications (e.g., #incidents-alerts).
# If left empty, Slack delivery is gracefully skipped without halting execution.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK_URL_HERE
SLACK_CHANNEL=#name-channel

# Slack Signing Secret (from Slack App > Basic Information > App Credentials).
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Slack User IDs authorized to click 'Approve & Execute' on Tier T2 mutations.
# Comma-separated (e.g., U0123456789,U9876543210).
SLACK_AUTHORIZED_APPROVERS=U0123456789

# Dedicated 64-char Hex HMAC-SHA256 key for signing and validating approval tags.
# Generate via: python3 -c "import secrets; print(secrets.token_hex(32))"
APPROVAL_MAC_KEY_HEX=your_64_character_hex_hmac_key_here

# Slack Bot User OAuth Token (xoxb-...) with chat:write permissions.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Slack App-Level Token (xapp-...) with connections:write for Socket Mode.
SLACK_APP_TOKEN=xapp-your-slack-app-level-token-here

# Optional: Slack Refresh Token (if using token rotation).
# SLACK_REFRESH_TOKEN=xoxe-your-refresh-token-here

# Human approval window timeout in seconds (default: 300s / 5 minutes).
# If expired, execution halts safely in a Fail-Closed posture.
SLACK_APPROVAL_TIMEOUT=300

# ── 7. Agent Reasoning Controls ───────────────────────────────────────────────
# Maximum allowed reasoning cycles per incident investigation before auto-conclude.
MAX_CYCLES=20
